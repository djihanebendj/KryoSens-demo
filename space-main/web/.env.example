# Backend base URL used by the Next.js server-side proxy (web/src/app/api/[...path]/route.ts).
# The browser never sees this value: do not rename it to NEXT_PUBLIC_COLDSENSE_API_URL.
# Copy this file to .env.local (git-ignored) for a local run:
#   Copy-Item web/.env.example web/.env.local
COLDSENSE_API_URL=http://127.0.0.1:8000
